{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "OpenOCD: Flash CM7_0",
      "type": "shell",
      "command": "${config:cortex-debug.openocdPath}",
      "group": "build",
      "options": {
        "cwd": "${workspaceFolder}",
        "shell": {
          "executable": "C:\\Windows\\System32\\cmd.exe",
          "args": [
            "/d",
            "/c",
            "chcp 936>nul &&"
          ]
        }
      },
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "clear": true
      },
      "args": [
        "-s",
        "${config:zf.openocd.scriptsPath}",
        "-f",
        "${config:zf.openocd.interfaceCfg}",
        "-c",
        "transport select swd",
        "-c",
        "set ADAPTER_SPEED ${config:zf.openocd.adapterSpeed}",
        "-c",
        "set ENABLE_ACQUIRE 0",
        "-c",
        "set ADAPTER_SRST_DELAY 200",
        "-c",
        "set ADAPTER_SRST_PULSE 300",
        "-c",
        "reset_config srst_only srst_nogate connect_deassert_srst",
        "-f",
        "${config:zf.openocd.targetCfg}",
        "-c",
        "init; reset halt; program {project/iar/Debug_m7_0/Exe/cyt4bb7_cm_7_0.hex} verify; reset run; shutdown"
      ],
      "problemMatcher": []
    },
